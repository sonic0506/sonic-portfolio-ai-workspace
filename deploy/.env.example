# Copy to deploy/.env on the server (chmod 600). Never commit the real file.
DB_PASSWORD=
OPENAI_API_KEY=
# Production GitHub OAuth App, callback https://admin.sonic-portfolio.com/login/oauth2/code/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Image uploads (deploy/S3_SETUP.md): upload-only IAM user key. Empty = uploads answer 503.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional: comma-separated owner IPs that skip the chat limit
CHAT_LIMIT_EXEMPT_IPS=
