{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://api.sonic-portfolio.com/api/:path*" },
    { "source": "/oauth2/:path*", "destination": "https://api.sonic-portfolio.com/oauth2/:path*" },
    { "source": "/login/oauth2/:path*", "destination": "https://api.sonic-portfolio.com/login/oauth2/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
